<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded input box background (Desh translation_view_edit_text_bg). White base,
     tinted at runtime with the HeliBoard theme color. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <solid android:color="#FFFFFF" />
    <!-- Desh: 1dp outlineVariant stroke. foreground_weak is the HeliBoard neutral,
         visible on light fills, subtle on dark fills (matches outlineVariant intent). -->
    <stroke
        android:width="1dp"
        android:color="@color/foreground_weak" />
</shape>
