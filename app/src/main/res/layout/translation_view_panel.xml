<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from Desh Keyboard v17.4.9 — layout_translation_view.xml.
     Same structure: close button top-right (CloseIcon), language row
     (tvTranslateFrom / switch / tvTranslateTo), error row (cl_error), input box
     (cvEditText) below the close row. ConstraintLayout is not a HeliBoard
     dependency, so the same visual/interaction structure is reproduced with
     FrameLayout. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/translation_panel_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="8dp">

    <!-- close button, top right (Desh CloseIcon: 34dp, ic_close) -->
    <ImageButton
        android:id="@+id/closeTranslate"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/translate_close"
        android:padding="7dp"
        android:src="@drawable/ic_close_desh"
        android:background="@drawable/secondary_button_background_rounded" />

    <!-- language row: from label + switch + to label (clTranslateFromToContainer) -->
    <LinearLayout
        android:id="@+id/clTranslateFromToContainer"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTranslateFrom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/translation_language_name_bg"
            android:ellipsize="end"
            android:maxEms="6"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/ibLanguageSwitchSwitch"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/secondary_button_background_rounded"
            android:contentDescription="@string/translate_switch_languages"
            android:minHeight="34dp"
            android:padding="4dp"
            android:src="@drawable/ic_translate_language_switch" />

        <TextView
            android:id="@+id/tvTranslateTo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/translation_language_name_bg"
            android:ellipsize="end"
            android:maxEms="6"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- error row (Desh cl_error): no-internet icon / error icon, message, dots, retry -->
    <LinearLayout
        android:id="@+id/cl_error"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/icNoInternet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_no_internet" />

        <ImageView
            android:id="@+id/icError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_unknown_error"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvDots"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/translation_language_name_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/translate_retry"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- input box (Desh cvEditText), below the close row -->
    <LinearLayout
        android:id="@+id/cvEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="8dp"
        android:layout_marginTop="58dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/translation_view_edit_text_bg"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etTranslate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp"
            android:background="@null"
            android:ellipsize="end"
            android:gravity="start"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:minHeight="30dp"
            android:minLines="1"
            android:textCursorDrawable="@drawable/cursor_drawable_with_primary_text_color"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
